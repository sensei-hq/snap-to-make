{
  "name": "burn-e-snap-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "vite dev --port 5174 --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --port 5174 --host 127.0.0.1",
    "prepare": "svelte-kit sync || echo ''",
    "sync": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:arch": "node scripts/check-arch.mjs",
    "test:db": "vitest run --config vitest.config.ts src/lib/server/db.spec.ts",
    "verify": "bun run test:arch && bun run lint && bun run check && bun run test:coverage",
    "verify:full": "bun run verify && bun run build && bun run test:e2e",
    "db:inspect": "cd ../database && dbd inspect",
    "db:deploy": "cd ../database && dbd deploy -d $DATABASE_URL -e dev --scope snap",
    "db:import": "cd ../database && dbd import -d $DATABASE_URL --scope snap",
    "deploy:dry": "bun run build:cf && wrangler deploy --dry-run",
    "deploy": "bun run build:cf && wrangler deploy",
    "types": "wrangler types",
    "build:cf": "WORKERS_CI=1 vite build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/solar": "^1.2.5",
    "@playwright/test": "^1.49.0",
    "@rokkit/cli": "^1.9.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.57.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^25.9.3",
    "@unocss/reset": "^66.6.8",
    "@vitest/coverage-v8": "^4",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.55.4",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "unocss": "^66.6.8",
    "vite": "^8.0.8",
    "vitest": "^4",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@rokkit/actions": "^1.9.0",
    "@rokkit/app": "^1.9.0",
    "@rokkit/core": "^1.9.0",
    "@rokkit/icons": "^1.9.0",
    "@rokkit/states": "^1.9.0",
    "@rokkit/themes": "^1.9.0",
    "@rokkit/ui": "^1.9.0",
    "@rokkit/unocss": "^1.9.0",
    "@supabase/supabase-js": "^2.99.1",
    "openai": "^4.77.0",
    "zod": "^3.24.0"
  }
}
