# Browser (publishable, safe to ship)
PUBLIC_SUPABASE_URL=http://127.0.0.1:56331
PUBLIC_SUPABASE_ANON_KEY=
# Server only — never PUBLIC_ prefixed, never committed
SUPABASE_SERVICE_ROLE_KEY=
META_API_KEY=
# comma-separated invite codes for the gate (no codes are built in); e2e uses the first
SNAP_INVITE_CODES=
# signs the gate's session cookie; required in production (openssl rand -base64 32)
SESSION_SECRET=
BURN_E_KILL_SWITCH=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56332/postgres
